# AWS Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────────────────────────
# AWS Credentials (use IAM roles in production; keys only for local dev/testing)
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# S3 Configuration
# ─────────────────────────────────────────────────────────────────────────────
RAW_BUCKET_NAME=banking-raw-data-your-suffix
TABLE_BUCKET_NAME=banking-lakehouse-your-suffix

# ─────────────────────────────────────────────────────────────────────────────
# Glue Configuration
# ─────────────────────────────────────────────────────────────────────────────
GLUE_JOB_NAME=banking-lakehouse-etl
GLUE_DATABASE=analytics_db
GLUE_TABLE=enriched_transactions
GLUE_IAM_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/GlueServiceRole

# ─────────────────────────────────────────────────────────────────────────────
# Athena Configuration
# ─────────────────────────────────────────────────────────────────────────────
ATHENA_RESULTS_BUCKET=s3://banking-raw-data-your-suffix/athena-results/
ATHENA_CATALOG=s3tablescatalog

# ─────────────────────────────────────────────────────────────────────────────
# Data Generation
# ─────────────────────────────────────────────────────────────────────────────
DATA_OUTPUT_DIR=data/sample
NUM_TRANSACTIONS=100
